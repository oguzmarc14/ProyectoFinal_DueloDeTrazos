<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application

        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProyectoFinal_DueloDeTrazos">

        <!-- ACTIVITY PRINCIPAL -->
        <activity
            android:name=".ui.room.RoomActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla del juego -->
        <activity android:name=".ui.game.GameActivity" />

        <!-- Nuevas Activities -->
        <activity android:name=".ui.room.CreateRoomActivity" />
        <activity android:name=".ui.room.JoinRoomActivity" />

    </application>

</manifest>

